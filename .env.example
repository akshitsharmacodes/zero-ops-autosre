# Copy to .env and fill in what you need. Never commit .env.

# --- Mode ---------------------------------------------------------------
# cached = scripted agent brain (no API keys), live = real LLM, replay = recorded run
AUTOSRE_MODE=cached
AUTOSRE_MAX_ATTEMPTS=3

# --- LLM (live mode) ----------------------------------------------------
LLM_PROVIDER=groq                 # groq | nvidia
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# --- Monitored database (AutoSRE's own least-privilege role) ------------
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_NAME=victim_db
TARGET_DB_USER=autosre_agent
TARGET_DB_PASSWORD=autosre_agent_pw
TARGET_APP_NAME_PREFIX=victim-service

# --- Victim app ---------------------------------------------------------
VICTIM_BASE_URL=http://localhost:8001
# VICTIM_LOG_PATH defaults to var/logs/victim.log

# --- Delivery -----------------------------------------------------------
DELIVERY_PROVIDER=local           # local (offline bare repo) | github
GITHUB_TOKEN=
GITHUB_REPO=                      # e.g. your-org/victim-service

# --- Sandbox ------------------------------------------------------------
SANDBOX_ENGINE=auto               # auto | docker | subprocess (NOT isolated)
SANDBOX_TIMEOUT_SECONDS=120

# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DEBUG=True
