# Environment Configuration for AutoSRE

# Mode: cached | live | replay
AUTOSRE_MODE=cached
AUTOSRE_MAX_ATTEMPTS=3

# Database configuration (PostgreSQL 15)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=victim_db
POSTGRES_USER=autosre
POSTGRES_PASSWORD=autosre_password

# Django Backend Configuration
DJANGO_SECRET_KEY=autosre-super-secret-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM Providers (Required only for live mode)
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# GitHub Delivery (Optional in cached mode)
GITHUB_TOKEN=
GITHUB_REPO=zero-ops/victim-service

# Paths
VICTIM_REPO_PATH=../victim_service
